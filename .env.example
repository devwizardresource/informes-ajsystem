# AJ System · Configuración de ejemplo (SIN secretos reales).
# Copie a .env (desarrollo) o defina estas variables en el entorno del servidor (producción).
# Genere secretos con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

AJS_ENV=development                 # development | production
AJS_SECRET_KEY=cambie-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres
AJS_AUDIT_HMAC_KEY=otro-valor-aleatorio-distinto-de-al-menos-32-caracteres

# Base de datos (cuenta de la APLICACIÓN, privilegios mínimos)
AJS_DB_HOST=127.0.0.1
AJS_DB_PORT=3306
AJS_DB_NAME=ajsystem
AJS_DB_USER=ajsys_app
AJS_DB_PASSWORD=cambie-esto
AJS_DB_SSL=1                        # TLS hacia MySQL

# Cuenta PROPIETARIA (solo para respaldos; no la use la aplicación web)
AJS_DB_ADMIN_USER=ajsys_owner
AJS_DB_ADMIN_PASSWORD=cambie-esto
# Cuenta DBA para bootstrap/migraciones/restauración: solo en la máquina de operación, nunca en producción web.
# AJS_DB_ROOT_PASSWORD=

# Sesiones y red
AJS_COOKIE_SECURE=0                 # 1 obligatorio en producción (HTTPS)
AJS_SESSION_IDLE_MINUTES=30
AJS_SESSION_ABSOLUTE_HOURS=8
AJS_TRUST_PROXY_HOPS=0              # >0 solo si hay un proxy inverso configurado y autorizado
AJS_LOGIN_MAX_FAILURES_USER=5
AJS_LOGIN_MAX_FAILURES_IP=20
AJS_LOGIN_WINDOW_MINUTES=15

# Presentación
AJS_TIMEZONE=America/Bogota         # zona para mostrar fechas (se almacenan en UTC)
AJS_REPORT_CODE_PREFIX=AJ
AJS_REPORT_TEMPLATE=aj_v1                # formato oficial (ajsystem/report_templates/aj_v1.json)
AJS_PAGE_SIZE=20
# AJS_PUBLIC_BASE_URL=https://informes.su-dominio.com  # URL pública usada en invitaciones por WhatsApp

# Respaldos
AJS_BACKUP_DIR=backups
AJS_MYSQLDUMP_BIN=mysqldump
AJS_MYSQL_BIN=mysql
# Desarrollo sin clientes MySQL instalados:
# AJS_MYSQLDUMP_BIN="scripts/docker-mysql-tool.sh mysqldump"
# AJS_MYSQL_BIN="scripts/docker-mysql-tool.sh mysql"

# Despliegue en Hostinger (server.js). Ver docs/DESPLIEGUE.md
# AJS_INITIAL_ADMIN_USER=responsable          # crea el primer RESPONSABLE si no existe ninguno
# AJS_INITIAL_ADMIN_NAME=Nombre Apellido
# AJS_INITIAL_ADMIN_PASSWORD=                 # temporal; bórrela tras el primer acceso
# AJS_AUTO_MIGRATE=1                          # 0 para no migrar al arrancar
# AJS_EDGE_PROXY_HOPS=1                       # proxies de Hostinger delante de Node
